def _answerability_reorder(
    *,
    candidates: Sequence[RerankedCandidate],
    query_text: str,
    answer_need: str,
) -> list[RerankedCandidate]:
    if answer_need == ANSWER_NEED_GENERAL:
        return list(candidates)

    decorated: list[tuple[float, int, int, RerankedCandidate]] = []

    for index, candidate in enumerate(candidates):
        assessment = assess_candidate_answerability(
            query=query_text,
            text=_candidate_search_text(candidate),
            heading=_heading_text(candidate),
            answer_need=answer_need,
        )

        # Lower tuple sorts first. Answer-bearing candidates float upward;
        # mention-only candidates sink even if they share the entity phrase.
        decorated.append(
            (
                -float(assessment.score),
                1 if assessment.mention_only else 0,
                index,
                candidate,
            )
        )

    decorated.sort(key=lambda item: (item[0], item[1], item[2]))
    return [item[3] for item in decorated]


def _answerability_filter_selected(
    *,
    candidates: Sequence[RerankedCandidate],
    query_text: str,
    answer_need: str,
) -> list[RerankedCandidate]:
    if answer_need == ANSWER_NEED_GENERAL:
        return list(candidates)

    assessed = [
        (
            candidate,
            assess_candidate_answerability(
                query=query_text,
                text=_candidate_search_text(candidate),
                heading=_heading_text(candidate),
                answer_need=answer_need,
            ),
        )
        for candidate in candidates
    ]

    answer_bearing = [
        candidate
        for candidate, assessment in assessed
        if assessment.answer_bearing
    ]

    if answer_bearing:
        # Keep answer-bearing chunks first. Keep non-mention-only supporting
        # chunks after them, but never let a weak ad/link/tip be the only context.
        supporting = [
            candidate
            for candidate, assessment in assessed
            if not assessment.answer_bearing and not assessment.mention_only
        ]
        return list(dict.fromkeys([*answer_bearing, *supporting]))

    non_mention_only = [
        candidate
        for candidate, assessment in assessed
        if not assessment.mention_only
    ]

    # If all selected chunks only mention the entity but do not answer the
    # requested task, return no context. The adaptive graph can then recover
    # instead of feeding weak context into generation.
    return non_mention_only

